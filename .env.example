# ── Panel de PRUEBA — Studio Bandito, migración de schema a Corte Inglés ──
# Ruta persistente de la base. En EasyPanel apunta al volumen /data.
# OJO: el nombre tiene que ser el que realmente se sube al volumen, no
# "corteingles.db" — ver la nota en el Dockerfile.
DB_PATH=/data/bandito-migrado.db
# Firma de la cookie de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=string-aleatorio-largo-para-firmar-cookies
# El PIN de acceso NO va acá: está en src/lib/client.config.ts (loginPin).

# ── Bot de WhatsApp (estructura heredada, NO conectada en este panel) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Backup automático a Google Drive (opcional) ─────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# ── Bootstrap de UNA sola vez, para sembrar el volumen /data recién creado
# con la base ya migrada — ver src/app/api/admin/restore-db/route.ts.
# Dejar en "false" (o sin setear) salvo el momento puntual del primer
# deploy: es un endpoint que escribe en disco, no debe quedar habilitado
# de forma permanente.
ALLOW_DB_RESTORE=false
